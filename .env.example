# === Banco de dados ===
POSTGRES_DB=gestao_clientes
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha

# === Backend ===
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gestao_clientes
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# === JWT ===
# Mínimo 32 bytes (256 bits). A app não sobe se for menor.
JWT_SECRET=dev-local-secret-nao-usar-em-producao-256bits!!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# === Portas ===
PORT_FRONTEND=8083
PORT_BACKEND=8082
PORT_DB=5432
